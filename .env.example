# ============================================================
# FJCWO-Web 環境變數範本
# 用法：複製本檔為 .env（.env 不進 git），再依需要填值。
# 完整建置流程、機密值申請與驗證步驟 → _notes/SETUP.md
# ============================================================

# ---- Django 核心（必填）----
# 正式環境：SECRET_KEY 換新值、DEBUG 設 False、ALLOWED_HOSTS 填正式網域（見 SETUP.md 情境 D）
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# ---- 資料庫 PostgreSQL（必填）----
DB_NAME=fjcwo
DB_USER=fjcwo_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ---- LINE Bot 通知（選填）----
# 兩者留空＝跳過推播、不報錯；要真的推到群組才填。申請步驟見 SETUP.md 情境 B-1
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=

# ---- 寄信 Email（選填）----
# USER/PASSWORD 留空＝自動改用 console backend（信印在終端機，免申請 SMTP）
# 要真的寄信才填；PASSWORD 用 Gmail「應用程式密碼」非登入密碼。步驟見 SETUP.md 情境 B-2
# 注意：EMAIL_USE_TLS 大小寫敏感，必須是 True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@fjcwo.local
